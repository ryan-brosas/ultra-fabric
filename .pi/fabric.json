{
  "configVersion": 1,
  "prewalk": {
    "thinking": "max",
    "verificationMode": "gated",
    "maxPhaseRevisions": 5,
    "model": "makora/zai-org/GLM-5.2-NVFP4",
    "alwaysRearm": true,
    "autoArm": true,
    "returnPolicy": "previous",
    "triggerRefs": [
      "pi.edit",
      "pi.write",
      "schema.commit"
    ]
  },
  "agents": {
    "retainRuns": true,
    "runRoot": "/home/ryanj/work/projects/ultra-fabric/.pi/fabric/runs"
  },
  "compaction": {
    "thresholds": {
      "openai-codex/gpt-5.6-sol": 0.5
    }
  },
  "quality": {
    "mode": "audit",
    "checks": [
      {
        "id": "typecheck",
        "languages": [
          "typescript"
        ],
        "command": "pnpm",
        "args": [
          "exec",
          "tsc",
          "--noEmit"
        ],
        "fileMode": "none",
        "timeoutMs": 120000
      }
    ]
  },
  "executor": {
    "runtime": "node-process",
    "memoryLimitBytes": 8589934592
  },
  "consult": {
    "maxFindingsPerWorker": 16
  }
}
