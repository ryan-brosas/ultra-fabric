{
  "configVersion": 3,
  "prewalk": {
    "thinking": "max",
    "delegateContext": true,
    "handoffRetirement": true,
    "reuseChecklists": true,
    "verificationMode": "gated",
    "maxPhaseRevisions": 5,
    "model": "omniroute/opencode-go/deepseek-v4-flash",
    "arm": "off",
    "triggerRefs": [
      "fabric.prewalk.checklist",
      "pi.edit",
      "pi.write",
      "schema.commit"
    ]
  },
  "agents": {
    "retainRuns": true,
    "runRoot": "/home/ryanj/work/projects/ultra-fabric/.pi/fabric/runs",
    "allowQualityDowngrade": false,
    "model": "omniroute/opencode-go/deepseek-v4-flash",
    "transport": "localterm",
    "thinking": "max",
    "maxDepth": 6,
    "roleModels": {
      "scout": "omniroute/opencode-go/deepseek-v4-flash",
      "advisor": "omniroute/opencode-go/deepseek-v4-flash",
      "coordinator": "omniroute/opencode-go/deepseek-v4-flash",
      "explorer": "omniroute/opencode-go/deepseek-v4-flash",
      "supervisor": "omniroute/opencode-go/deepseek-v4-flash"
    }
  },
  "compaction": {
    "thresholds": {
      "openai-codex/gpt-5.6-sol": 0.5
    },
    "contextQos": {
      "turnWindow": 5
    },
    "engine": "fabric",
    "targetContextRatio": 0.6
  },
  "quality": {
    "mode": "audit",
    "ignoredLanguages": [
      "binary",
      "markdown"
    ],
    "checks": [
      {
        "id": "typecheck",
        "languages": [
          "typescript"
        ],
        "command": "pnpm",
        "args": [
          "exec",
          "tsc",
          "--noEmit"
        ],
        "fileMode": "none",
        "timeoutMs": 120000
      },
      {
        "id": "json-syntax",
        "languages": [
          "json"
        ],
        "command": "node",
        "args": [
          "-e",
          "JSON.parse(require('fs').readFileSync(process.argv[1],'utf8'))"
        ],
        "fileMode": "append",
        "timeoutMs": 15000
      },
      {
        "id": "yaml-syntax",
        "languages": [
          "yaml"
        ],
        "command": "node",
        "args": [
          "-e",
          "require('yaml').parse(require('fs').readFileSync(process.argv[1],'utf8'))"
        ],
        "fileMode": "append",
        "timeoutMs": 15000
      }
    ]
  },
  "executor": {
    "runtime": "node-process",
    "memoryLimitBytes": 8589934592
  },
  "consult": {
    "maxFindingsPerWorker": 16,
    "maxTokensPerWorker": 64000,
    "maxEvidenceBytesPerConsult": 33554432,
    "maxEvidenceFileBytes": 8388608
  }
}
