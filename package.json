{
  "name": "ultra-fabric",
  "version": "0.31.1-ultra.17",
  "description": "A resilient, adaptive orchestration runtime for Pi",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./protocol": {
      "types": "./dist/protocol.d.ts",
      "import": "./dist/protocol.js"
    }
  },
  "files": [
    "dist/",
    "agents/",
    "skills/",
    "docs/",
    "scripts/",
    "CHANGELOG.md",
    "README.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md"
  ],
  "publishConfig": {
    "access": "public",
    "tag": "next"
  },
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "smoke:package": "node scripts/smoke-pi-package.mjs",
    "certify:context": "pnpm run build && node scripts/certify-context.mjs",
    "benchmark:real-resume": "pnpm run build && node scripts/benchmark-real-resume.mjs",
    "benchmark:prewalk": "node scripts/benchmark-prewalk.mjs",
    "benchmark:prewalk:corpus": "node scripts/build-prewalk-corpus.mjs",
    "benchmark:prewalk:real": "pnpm run build && node scripts/benchmark-prewalk-real.mjs",
    "benchmark:memory-heads": "pnpm run build && node scripts/benchmark-memory-heads.mjs",
    "benchmark:codemap": "pnpm run build && node scripts/benchmark-codemap.mjs",
    "benchmark:codemap:grep": "pnpm run build && node scripts/benchmark-codemap-vs-grep.mjs",
    "benchmark:codemap:depth": "pnpm run build && node scripts/benchmark-expand-depth.mjs",
    "stress:codemap": "pnpm run build && node scripts/stress-codemap.mjs",
    "benchmark:codemap:holdout": "pnpm run build && node scripts/validate-codemap-holdout.mjs",
    "lint:dead": "knip --no-gitignore",
    "check": "pnpm run typecheck && pnpm run build && pnpm run test && pnpm run lint:dead && pnpm run smoke:package",
    "prepare": "npm run build",
    "prepack": "pnpm run check"
  },
  "keywords": [
    "pi-package",
    "pi-extension",
    "codemode",
    "mcp",
    "agents",
    "steering",
    "mesh",
    "swarm",
    "workflows",
    "rlm",
    "orchestration"
  ],
  "license": "MIT",
  "author": "Ryan Brosas",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ryan-brosas/ultra-fabric.git"
  },
  "homepage": "https://github.com/ryan-brosas/ultra-fabric#readme",
  "bugs": {
    "url": "https://github.com/ryan-brosas/ultra-fabric/issues"
  },
  "engines": {
    "node": ">=24"
  },
  "pi": {
    "extensions": [
      "./dist/index.js"
    ],
    "skills": [
      "./skills"
    ],
    "image": "https://raw.githubusercontent.com/monotykamary/pi-fabric/main/media/cover.jpg"
  },
  "dependencies": {
    "@jitl/quickjs-singlefile-mjs-release-sync": "^0.32.0",
    "cross-spawn": "^7.0.6",
    "diff": "^9.0.0",
    "mcporter": "^0.12.3",
    "quickjs-emscripten-core": "^0.32.0",
    "shiki": "^4.3.1",
    "typebox": "1.3.8",
    "typescript": "^6.0.3",
    "yaml": "^2.9.0"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*"
  },
  "devDependencies": {
    "@ast-grep/cli": "^0.45.0",
    "@earendil-works/pi-ai": "0.84.1",
    "@earendil-works/pi-coding-agent": "0.84.1",
    "@earendil-works/pi-tui": "0.84.1",
    "@types/cross-spawn": "^6.0.6",
    "@types/node": "^26.1.2",
    "knip": "^6.29.0",
    "vitest": "^4.1.10"
  },
  "packageManager": "pnpm@11.18.0"
}
